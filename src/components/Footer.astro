---
import { cv } from '../lib/cv';
import { site, extraProfiles } from '../data/site';

const profiles = [
  ...cv.links.map((l) => ({
    label: l.url.includes('linkedin') ? 'LinkedIn' : l.url.includes('github') ? 'GitHub' : l.label,
    handle: l.label,
    url: l.url,
  })),
  ...extraProfiles,
];
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="wrap">
    <section class="contact" aria-labelledby="contact-title">
      <h2 class="contact__label" id="contact-title">contact</h2>
      <div>
        <p class="contact__lead">
          The quickest way to reach me is by email.
        </p>
        <a class="contact__email" href={`mailto:${cv.email}`}>{cv.email}</a>
        <ul class="contact__profiles">
          {
            profiles.map((p) => (
              <li>
                <span class="contact__service">{p.label}</span>
                <a href={p.url} rel="me noopener">{p.handle}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <div class="colophon">
      <p>© {year} {site.name}, {cv.location}</p>
      <ul>
        <li><a href="/rss.xml">rss</a></li>
        {site.sourceUrl && <li><a href={site.sourceUrl}>source</a></li>}
        <li>
          <button type="button" id="theme-toggle" aria-label="Switch colour theme">
            theme: <span data-theme-label>auto</span>
          </button>
        </li>
      </ul>
    </div>
  </div>
</footer>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const button = document.getElementById('theme-toggle');
    const label = button.querySelector('[data-theme-label]');
    const system = () => (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const current = () => root.dataset.theme || system();
    const render = () => (label.textContent = current());
    render();
    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        // Following the system again is the default: only store a real override.
        if (next === system()) localStorage.removeItem('theme');
        else localStorage.setItem('theme', next);
      } catch {}
      render();
    });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', render);
  })();
</script>

<style>
  .site-footer {
    margin-top: var(--s-8);
    border-top: 2px solid var(--ink);
  }
  .contact {
    display: grid;
    grid-template-columns: var(--label) minmax(0, 1fr);
    column-gap: var(--s-6);
    padding-block: var(--s-6);
  }
  .contact__label {
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
    line-height: 1.6;
    color: var(--muted);
    padding-top: 0.2rem;
  }
  .contact__lead {
    color: var(--muted);
  }
  .contact__email {
    display: inline-block;
    margin-top: var(--s-1);
    font-family: var(--mono);
    font-weight: 500;
    font-size: clamp(1.125rem, 0.7rem + 2.1vw, 1.75rem);
    letter-spacing: var(--tracking-mono);
    line-height: 1.3;
    overflow-wrap: anywhere;
    text-underline-offset: 0.28em;
  }
  .contact__profiles {
    list-style: none;
    margin-top: var(--s-4);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--s-2) var(--s-4);
    font-family: var(--mono);
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
  }
  .contact__profiles li {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .contact__service {
    color: var(--muted);
  }
  .colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-1) var(--s-4);
    padding-block: var(--s-3);
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .colophon ul {
    list-style: none;
    display: flex;
    gap: var(--s-3);
  }
  .colophon a {
    text-decoration-color: transparent;
  }
  .colophon a:hover {
    text-decoration-color: var(--accent);
    color: var(--ink);
  }
  button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  button:hover {
    color: var(--ink);
  }

  @media (max-width: 52rem) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s-3);
      padding-block: var(--s-4);
    }
  }
</style>
