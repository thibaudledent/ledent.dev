---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { cv, inline, plain, list, isCurrent, parseMission } from '../lib/cv';
import { site } from '../data/site';

const emp = cv.employment;
---

<Base
  title="Experience"
  description={plain(cv.profile)}
>
  <header class="page-head">
    <h1>Experience</h1>
    <p class="page-head__lead">
      {cv.title.replace(' · ', ' and ')}, based in {cv.location}.
    </p>
    <p class="cv-link">
      <a href={site.cvPdf}>Download the one-page CV (PDF)</a>
    </p>
  </header>

  <Section label="freelance">
    {
      cv.experience.map((e) => (
        <article class="xp">
          <header class="xp__head">
            <h3>{e.project}</h3>
            <p class="xp__dates">
              {e.dates}
              {isCurrent(e.dates) && <span class="cursor" aria-hidden="true" />}
            </p>
          </header>
          <p class="xp__role">
            {e.role}, {e.client}, {e.location}
          </p>
          {e.summary && <p class="xp__summary" set:html={inline(e.summary)} />}
          <ul class="xp__bullets">
            {e.bullets.map((b) => <li set:html={inline(b)} />)}
          </ul>
          {e.stack && <p class="xp__stack">{list(e.stack).join(', ')}</p>}
        </article>
      ))
    }
  </Section>

  <Section label="employment">
    <article class="xp">
      <header class="xp__head">
        <h3>{emp.employer}</h3>
        <p class="xp__dates">{emp.dates}</p>
      </header>
      <p class="xp__role">{emp.role}, {emp.location}</p>
      <p class="xp__summary" set:html={inline(emp.intro.replace(/\s*—\s*payments:\s*$/, ', in payments.'))} />
    </article>

    {
      emp.missions.map((m) => {
        const { title, role, place } = parseMission(m.name);
        return (
          <article class="xp xp--mission">
            <header class="xp__head">
              <h4>{title}</h4>
              <p class="xp__dates">{m.dates}</p>
            </header>
            <p class="xp__role">{[role, place].filter(Boolean).join(', ')}</p>
            {m.summary && <p class="xp__summary" set:html={inline(m.summary)} />}
            <ul class="xp__bullets">
              {m.bullets.map((b) => <li set:html={inline(b)} />)}
            </ul>
            {m.stack && <p class="xp__stack">{list(m.stack).join(', ')}</p>}
          </article>
        );
      })
    }
  </Section>

  <Section label="skills">
    <dl class="pairs">
      {
        cv.skills.map((s) => (
          <div>
            <dt>{s.group}</dt>
            <dd>{list(s.items).join(', ')}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section label="education">
    <ul class="plain">
      {cv.education.map((e) => <li set:html={inline(e)} />)}
    </ul>
  </Section>

  <Section label="certifications">
    <ul class="plain">
      {cv.certifications.map((c) => <li set:html={inline(c)} />)}
    </ul>
  </Section>

  <Section label="languages">
    <p>{list(cv.languages).join(', ')}</p>
  </Section>

  <Section label="open source">
    <p class="measure" set:html={inline(cv.open_source)} />
    <p class="section__more"><a href="/projects/">See all projects</a></p>
  </Section>
</Base>

<style>
  .cv-link {
    margin-top: var(--s-3);
    font-family: var(--mono);
    font-size: var(--text-sm);
  }
  .xp {
    max-width: 46rem;
  }
  .xp + .xp {
    margin-top: var(--s-6);
  }
  .xp--mission {
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }
  .xp + .xp--mission {
    margin-top: var(--s-4);
  }
  .xp__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem var(--s-3);
  }
  .xp h3 {
    font-size: var(--text-xl);
  }
  .xp h4 {
    font-size: var(--text-lg);
  }
  .xp__dates {
    font-family: var(--mono);
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
    color: var(--muted);
    white-space: nowrap;
  }
  .xp__role {
    margin-top: 0.375rem;
    color: var(--muted);
  }
  .xp__summary {
    margin-top: var(--s-2);
  }
  .xp__bullets {
    list-style: none;
    margin-top: var(--s-2);
    padding-left: 1.25em;
  }
  .xp__bullets li {
    position: relative;
  }
  .xp__bullets li + li {
    margin-top: 0.5em;
  }
  .xp__bullets li::before {
    content: '–';
    position: absolute;
    left: -1.25em;
    color: var(--faint);
  }
  .xp__stack {
    margin-top: var(--s-2);
    font-family: var(--mono);
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
    line-height: 1.7;
    color: var(--muted);
  }
  .pairs > div {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    column-gap: var(--s-3);
    padding-block: 0.625rem;
    border-top: 1px solid var(--rule);
  }
  .pairs > div:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .pairs > div:last-child {
    padding-bottom: 0;
  }
  .pairs dt {
    font-family: var(--mono);
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
    color: var(--muted);
    padding-top: 0.2em;
  }
  .plain {
    list-style: none;
  }
  .plain li + li {
    margin-top: 0.5em;
  }
  .measure {
    max-width: var(--measure);
  }
  @media (max-width: 40rem) {
    .pairs > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
