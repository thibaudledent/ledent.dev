---
import Base from '../layouts/Base.astro';
import { getRepos } from '../lib/github';

const repos = await getRepos();
---

<Base
  title="Projects"
  description="Open-source and personal projects by Thibaud Ledent on GitHub."
>
  <header class="page-head">
    <h1>Projects</h1>
    <p class="page-head__lead">
      Everything public on <a href="https://github.com/thibaudledent">GitHub</a>, most starred first.
    </p>
  </header>

  <ul class="rows projects">
    {
      repos.map((r) => (
        <li class="row">
          <span class="row__date">{r.language ?? ''}</span>
          <div>
            <h2 class="row__title">
              <a href={r.url}>{r.name}</a>
            </h2>
            {r.description && <p class="row__detail">{r.description}</p>}
            {r.homepage && (
              <p class="project__links">
                <a href={r.homepage}>{r.homepage.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a>
              </p>
            )}
          </div>
          <span class="row__figure muted">{r.stars > 0 ? `★ ${r.stars}` : ''}</span>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .projects {
    border-top: 1px solid var(--rule);
    padding-top: var(--s-4);
  }
  .projects .row {
    padding-block: var(--s-3);
  }
  .projects .row__title {
    font-size: var(--text-lg);
  }
  .projects .row__detail {
    max-width: var(--measure);
    margin-top: 0.375rem;
    font-size: 1rem;
    color: var(--ink);
  }
  .project__links {
    margin-top: 0.75rem;
    font-family: var(--mono);
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
  }
</style>
